{
  "name": "ai-codebase-doctor",
  "version": "1.0.0",
  "description": "AI Codebase Doctor - Automated health diagnostics, multi-dimensional code auditing, and git diff patch generator",
  "main": "backend/src/server.ts",
  "scripts": {
    "test:gemini": "node -r dotenv/config backend/test-gemini.js",
    "dev:backend": "tsx watch backend/src/server.ts",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"tsx watch backend/src/server.ts\" \"npm run dev --prefix frontend\"",
    "build:frontend": "npm run build --prefix frontend",
    "build:backend": "tsc -p backend/tsconfig.json",
    "build": "npm run build:frontend && npm run build:backend",
    "start": "node backend/dist/server.js",
    "doctor": "tsx backend/src/cli.ts"
  },
  "keywords": [
    "ai",
    "code-review",
    "doctor",
    "gemini",
    "aws",
    "security-scanner",
    "patch-generator"
  ],
  "author": "Codebase Doctor Team",
  "contributors": [
    {
      "name": "Ujjwal Kumar",
      "github": "Ujjwalkr0001",
      "email": "ujjwalkr0001@users.noreply.github.com",
      "role": "Project Lead / Creator"
    },
    {
      "name": "Trae AI Assistant",
      "github": "trae-ai",
      "role": "Automated Contributor",
      "url": "https://trae.ai"
    }
  ],
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.758.0",
    "@aws-sdk/client-dynamodb": "^3.758.0",
    "@aws-sdk/client-s3": "^3.758.0",
    "@aws-sdk/lib-dynamodb": "^3.758.0",
    "@google/genai": "^2.23.0",
    "adm-zip": "^0.5.16",
    "axios": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1",
    "serverless-http": "^4.0.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.13.10",
    "@types/uuid": "^10.0.0",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
